# Reproducible libjpeg-turbo for LibRaw's lossy-JPEG DNG decoder (USE_JPEG).
# Shared by the Android build and the host regression project.
#
# libjpeg-turbo refuses add_subdirectory() integration and asks downstream
# projects to use ExternalProject_Add(), which is what this does. The official
# release archive is pinned by URL + SHA-256; CMake verifies the hash before
# extracting, so a changed archive fails the configure step.
#
# Only the 8-bit baseline decompressor is needed (LibRaw's lossy_dng_load_raw;
# patch 0026 keeps the Kodak JPEG loader unreachable and refuses progressive,
# arithmetic and multi-scan tiles). The upstream library is built unmodified
# with its own build system: static, no TurboJPEG API, no tools, no tests, no
# arithmetic decoder.
#
# Two build details matter for safety, not speed:
#  * -fexceptions -funwind-tables: LibRaw's libjpeg error_exit handler THROWS a
#    C++ exception (jpegErrorExit_d in dng.cpp) through libjpeg's C frames. C
#    compiled without unwind tables turns every corrupt lossy DNG into
#    std::terminate(), i.e. a crash, instead of a typed decode error.
#  * SIMD is enabled only for ARM (NEON intrinsics, no extra assembler). The
#    x86 SIMD needs NASM, which the NDK does not ship; x86_64 is the emulator ABI.
include_guard(GLOBAL)
include(ExternalProject)

set(SFRAW_PINNED_LIBJPEG_TURBO_VERSION "3.1.4")
set(SFRAW_PINNED_LIBJPEG_TURBO_URL
    "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.1.4/libjpeg-turbo-3.1.4.tar.gz")
set(SFRAW_PINNED_LIBJPEG_TURBO_SHA256
    "e23d3ebb2c6ee4d0e2a5823dbb55b614845df5ea3435c956fed5cf04041a87ad")

# The same release archive, committed to the repository. GitHub's release-asset
# host has served 504s for long stretches (2026-11-08: every CI build on main
# failed at this download), and a build should not depend on it being up. The
# committed copy is used when present and the pinned URL only when it is not
# (a sparse checkout). Either way CMake checks the pinned SHA-256 before
# extracting, so the committed file cannot change what is built.
set(SFRAW_VENDORED_LIBJPEG_TURBO_ARCHIVE
    "${CMAKE_CURRENT_LIST_DIR}/../third_party/libjpeg-turbo-${SFRAW_PINNED_LIBJPEG_TURBO_VERSION}.tar.gz")
get_filename_component(SFRAW_VENDORED_LIBJPEG_TURBO_ARCHIVE
    "${SFRAW_VENDORED_LIBJPEG_TURBO_ARCHIVE}" ABSOLUTE)

set(SFRAW_LIBJPEG_TURBO_ARCHIVE "" CACHE FILEPATH
    "Offline copy of libjpeg-turbo-3.1.4.tar.gz; still verified against the pinned SHA-256")

# sfraw_add_libjpeg_turbo(<imported target> [EXTRA_C_FLAGS <flags...>])
# Creates a STATIC IMPORTED target exposing jpeglib.h and libjpeg.a.
function(sfraw_add_libjpeg_turbo target_name)
    cmake_parse_arguments(ARG "" "" "EXTRA_C_FLAGS" ${ARGN})
    set(_prefix "${CMAKE_CURRENT_BINARY_DIR}/sfraw-libjpeg-turbo")
    set(_install "${_prefix}/install")
    set(_library "${_install}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}")
    set(_include "${_install}/include")

    # A local path cannot share ExternalProject's URL list with a remote URL
    # (CMake rejects that mix), so the committed copy replaces the URL when present.
    set(_url "${SFRAW_PINNED_LIBJPEG_TURBO_URL}")
    if (EXISTS "${SFRAW_VENDORED_LIBJPEG_TURBO_ARCHIVE}")
        set(_url "${SFRAW_VENDORED_LIBJPEG_TURBO_ARCHIVE}")
    endif ()
    if (SFRAW_LIBJPEG_TURBO_ARCHIVE)
        set(_url "${SFRAW_LIBJPEG_TURBO_ARCHIVE}")
    endif ()

    set(_simd OFF)
    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|armv7.*|arm)$" OR
            ANDROID_ABI MATCHES "^(arm64-v8a|armeabi-v7a)$")
        set(_simd ON)
    endif ()

    # The extra flags are APPENDED after libjpeg-turbo's project() call through
    # CMAKE_PROJECT_INCLUDE. Passing -DCMAKE_C_FLAGS instead would suppress
    # CMAKE_C_FLAGS_INIT, i.e. drop the NDK toolchain's own flags (-DANDROID,
    # stack protector, FORTIFY) from the Android build.
    string(JOIN " " _c_flags -fexceptions -funwind-tables ${ARG_EXTRA_C_FLAGS})
    set(_flags_include "${_prefix}/sfraw-libjpeg-turbo-flags.cmake")
    file(WRITE "${_flags_include}"
        "# Generated by LibJpegTurboVendor.cmake\n"
        "string(APPEND CMAKE_C_FLAGS \" ${_c_flags}\")\n")

    set(_args
        -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_PROJECT_INCLUDE=${_flags_include}"
        -DCMAKE_INSTALL_PREFIX=${_install}
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_INSTALL_INCLUDEDIR=include
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON
        -DENABLE_SHARED=OFF
        -DENABLE_STATIC=ON
        -DWITH_TURBOJPEG=OFF
        -DWITH_JAVA=OFF
        -DWITH_TOOLS=OFF
        -DWITH_TESTS=OFF
        -DWITH_FUZZ=OFF
        -DWITH_ARITH_ENC=OFF
        -DWITH_ARITH_DEC=OFF
        -DWITH_SIMD=${_simd}
        -DREQUIRE_SIMD=OFF)
    if (CMAKE_C_COMPILER)
        list(APPEND _args "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}")
    endif ()
    if (CMAKE_MAKE_PROGRAM)
        # AGP hands CMake a native Windows path (C:\Users\...). Written verbatim into the
        # sub-build's generated configure script it reads as escape sequences ("\U") and
        # the Windows build fails; forward it in CMake's forward-slash form.
        file(TO_CMAKE_PATH "${CMAKE_MAKE_PROGRAM}" _make_program)
        list(APPEND _args "-DCMAKE_MAKE_PROGRAM=${_make_program}")
    endif ()
    # Cross builds (Android): forward the NDK toolchain exactly as the
    # Gradle-driven configure saw it. A native host build forwards none of
    # these; naming CMAKE_SYSTEM_NAME there would mark the sub-build as a cross
    # build and leave CMAKE_SYSTEM_PROCESSOR empty.
    if (CMAKE_CROSSCOMPILING)
        foreach (_var IN ITEMS CMAKE_TOOLCHAIN_FILE ANDROID_ABI ANDROID_PLATFORM
                ANDROID_NDK CMAKE_ANDROID_ARCH_ABI CMAKE_ANDROID_NDK
                CMAKE_SYSTEM_NAME CMAKE_SYSTEM_VERSION CMAKE_SYSTEM_PROCESSOR)
            if (DEFINED ${_var} AND NOT "${${_var}}" STREQUAL "")
                # Forward slashes: a Windows path's backslashes are read as
                # escapes when the sub-build's configure script is parsed.
                file(TO_CMAKE_PATH "${${_var}}" _value)
                list(APPEND _args "-D${_var}=${_value}")
            endif ()
        endforeach ()
    endif ()

    # DOWNLOAD_EXTRACT_TIMESTAMP exists from CMake 3.24; the pinned 3.22.1 does
    # not know the keyword and would misparse it.
    set(_timestamp_args)
    if (CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
        set(_timestamp_args DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    endif ()

    ExternalProject_Add(sfraw_libjpeg_turbo_build
        PREFIX "${_prefix}"
        URL "${_url}"
        URL_HASH "SHA256=${SFRAW_PINNED_LIBJPEG_TURBO_SHA256}"
        ${_timestamp_args}
        TLS_VERIFY TRUE
        CMAKE_GENERATOR "${CMAKE_GENERATOR}"
        CMAKE_ARGS ${_args}
        BUILD_BYPRODUCTS "${_library}"
        UPDATE_COMMAND ""
        LOG_CONFIGURE TRUE
        LOG_BUILD TRUE
        LOG_INSTALL TRUE
        LOG_OUTPUT_ON_FAILURE TRUE)

    # INTERFACE_INCLUDE_DIRECTORIES must exist at generate time.
    file(MAKE_DIRECTORY "${_include}")
    add_library(${target_name} STATIC IMPORTED GLOBAL)
    set_target_properties(${target_name} PROPERTIES
        IMPORTED_LOCATION "${_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${_include}")
    add_dependencies(${target_name} sfraw_libjpeg_turbo_build)
    message(STATUS "sfraw: libjpeg-turbo ${SFRAW_PINNED_LIBJPEG_TURBO_VERSION} "
            "(pinned SHA-256, SIMD=${_simd}) for lossy-JPEG DNG")
endfunction()
