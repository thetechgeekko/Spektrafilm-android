<?xml version="1.0" encoding="utf-8"?>
<!-- Spektrafilm for Android. GPLv3. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The update check makes one bounded HTTPS request to GitHub's API; an accepted update
         downloads the release's APK from GitHub (docs/UPDATER_SECURITY.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: hands the downloaded, signer-verified release APK to a PackageInstaller
         session. The user always confirms in the system installer; Android enforces signing-
         certificate continuity. Never used on a Play-installed copy (Play updates itself).
         A Play build must remove this permission (tools:node="remove"), see UPDATER_SECURITY.md. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A backgrounded export is moved to the little-cluster cpuset and runs ~4x
         slower (measured 13894 ms -> 55631 ms on a 12.5 MP export), and becomes a
         kill candidate for Samsung's device-health manager. ExportForegroundService
         holds the process in the foreground scheduling group while it renders. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 35+: export runs as mediaProcessing (ExportForegroundService.foregroundServiceTypeFor). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- API 33+: without this the ongoing-export notification is not shown. The
         service still gets foreground priority either way, so no runtime prompt is
         raised for it — the speed-up does not depend on the user granting this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Legacy gallery export (API <= 28) writes to public Pictures storage.
         On API 29+ scoped storage is used via MediaStore and needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- API 29+: MediaStore redacts the GPS bytes from a photo's stream unless the app holds
         this and opens the original-media form of the URI. Requested only when the user has
         turned "Include location (GPS)" on for a MediaStore photo (#261); denial means the
         export is written without GPS, nothing else. Ignored below API 29. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- The Library's Gallery tab lists the phone's photos (MediaStore). Asked for only when
         the user opens that tab; Android 14+ may grant just a selection of photos instead. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Large screens / desktop windowing: ChromeOS laptops and DeX with a mouse have no
         touchscreen. Nothing in the editor needs one (every gesture has a click or keyboard
         path), so do not let the store filter those devices out. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SpektraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:restoreAnyVersion="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spektrafilm"
        android:usesCleartextTraffic="false">
        <!-- Lets `adb shell simpleperf` attach to RELEASE builds (API 29+; ignored below).
             Grants profiling to the shell user only — no debugging surface is opened.
             Required by the docs/baseline capture wizard (issue #119). -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
        <!-- singleTask: an incoming VIEW/SEND must reach the one live editor through
             onNewIntent — a second Activity instance would fight the process-owned
             export/session runtimes for ownership. -->
        <!-- Large-screen quality (tablets, foldables, DeX, ChromeOS, Android desktop windows):
             no orientation lock, resizable, and the window-shape config changes are handled IN
             PLACE instead of recreating the Activity. The UI is Compose-only and already reacts
             to LocalConfiguration / constraints, while a recreate would tear down the GPU
             preview's GL context and re-read the editor session from disk on every window
             drag, fold, rotate or keyboard attach. Deliberately NOT listed: density (moving to
             another display), uiMode, locale and fontScale; those still recreate, as before.
             <layout> only sets the first size of a freeform/desktop window. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Spektrafilm.Starting"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="720dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- #467 static launcher shortcuts (Open photo, Library). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- #162 inbound import. content:// only — a file:// path is never adopted
                 (no path trust, no pre-scoped-storage semantics). MIME is advisory here;
                 the actual decode route is content-sniffed fail-closed (#190). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Several photos shared at once land in the Library's Imported album. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Runs no work of its own: it exists only to keep the process in the
             foreground scheduling group for the duration of an export. mediaProcessing on
             API 35+ (the type for long media transcodes/renders); dataSync below 35, where
             mediaProcessing does not exist. -->
        <service
            android:name=".ExportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Working copies of photos shared to the app with only a temporary grant (#508,
             SharedSourceCopies.kt). Not exported, and the app never hands out a grant for
             them, so only this app reads them. grantUriPermissions must still be true:
             FileProvider.attachInfo refuses to start without it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sharedsources"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_source_paths" />
        </provider>

        <!-- PackageInstaller session status for an in-app update. Not exported: only the
             explicit PendingIntent UpdateInstaller hands the system installer reaches it. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
