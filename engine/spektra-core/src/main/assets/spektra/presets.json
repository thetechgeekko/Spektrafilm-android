{
  "version": 3,
  "_comment": "Built-in looks (six, chosen 2026-11 as the films photographers most often buy, name and emulate; see docs/PRESETS.md) are sparse overlays authored against the nested SpektraParams schema and mapped by BuiltInPresets.applyParams; omitted fields retain their current editor values. Only ENGINE-HONORED fields are set: grain is fully tunable (and per-stock here, since the engine otherwise gives every stock Portra-400 grain); halation uses halationAmount/scatterAmount/boost (halationStrength + halationFirstSigmaUm are baked from each profile's use/antihalation tags and ignored); DIR couplers use amount/inhibition/diffusion (gamma matrices are baked per stock); diffusionFilter geometry and filterFamily are honored. Grain/halation are um-based and so look stronger at full-res/zoom than in the fit preview. Every look authors enlarger y/mFilterShift so browsing between looks never carries one look's print colour into another.",
  "presets": [
    {
      "id": "portra_400",
      "name": "Portra 400",
      "group": "Portrait",
      "description": "Warm, forgiving skin and soft contrast on Portra Endura: the film people mean when they say \"the film look\". Auto-metered, a third of a stop over.",
      "params": {
        "filmProfile": "kodak_portra_400",
        "printProfile": "kodak_portra_endura",
        "io": {
          "scanFilm": false,
          "outputColorSpace": "SRGB"
        },
        "camera": {
          "exposureCompensationEv": 0.3,
          "autoExposure": true,
          "autoExposureMethod": "center_weighted"
        },
        "filmRender": {
          "densityCurveGamma": 0.96,
          "grain": {
            "active": true,
            "sublayersActive": true,
            "blur": 0.7,
            "agxParticleScale": [
              0.85,
              1.05,
              2.1
            ],
            "uniformity": [
              0.97,
              0.97,
              0.99
            ],
            "blurDyeCloudsUm": 1.0,
            "microStructure": [
              0.2,
              30
            ],
            "nSubLayers": 1
          },
          "halation": {
            "active": true,
            "halationAmount": 1.0,
            "scatterAmount": 1.0
          },
          "dirCouplers": {
            "active": true,
            "amount": 1.0,
            "inhibitionInterlayer": 1.0
          }
        },
        "scanner": {
          "unsharpMask": [
            0.5,
            0.7
          ]
        },
        "enlarger": {
          "yFilterShift": 0.0,
          "mFilterShift": 0.0
        }
      }
    },
