//
// In-emulsion scatter + back-reflection halation on the GPU (issue #206).
//
// Adapted from chaert-s/spektrafilm-ofx shaders/vulkan/SpektraHalation.comp at
// 86476afc5b077de77e2278e3658d1ba9309892a1 (GPL-3.0-only). Upstream's pass
// structure (op-multiplexed kernel, X-then-Y separable blurs accumulated into
// a sum buffer, scatter and bounce resolves) is kept. Android changes (this
// file is a MODIFIED copy; see docs/research/spektrafilm-ofx-port.md):
//   * every film-dependent constant upstream hard-coded (scatter core/tail
//     sigmas, tail mix, bounce decay/normalisation) comes from FrameFloats, so
//     the pass follows this engine's digested HalationParams per film;
//   * the blur is the engine's own Gaussian, per channel: the Young-van Vliet
//     3rd-order IIR for sigma >= 3 and the truncated FIR (radius
//     int(3*sigma + 0.5), scipy 'reflect') below, with the CPU's coefficients
//     and edge initialisation (kernels/exponential_filter.cpp), because the
//     f64 CPU pass and the Python oracle are the ground truth here and their
//     IIR has visibly different edge behaviour from a truncated FIR.
//     FIR-class channels stay per-pixel (upstream's shape); IIR-class
//     channels run one thread per column, and an X pass goes through a tiled
//     transpose so the recursion always walks columns (coalesced), which a
//     per-row thread layout is not. The pass runs on the whole frame, so the
//     IIR sweeps see the complete column exactly as the CPU does;
//   * this shader derives NO parameter of its own. Sigma, the FIR/IIR class,
//     the accumulation weight and the IIR coefficients all come from a table
//     the host computes in f64 (see BlurTable below), because the same f32
//     arithmetic that costs the IIR its accuracy also made the device and the
//     host disagree about which channels are IIR-class;
//   * the scatter core and the three tail Gaussians fold into ONE weighted
//     sum ((1 - w) for the core, w * amp_k for the tails), so four device
//     buffers cover the whole pass: source, sum, X-blurred, transposed;
//   * buffers are packed float triples (3 x f32 per pixel), not vec4;
//   * a raw-domain bounce resolve (kOpBounceResolveRaw) with the engine's
//     halation_renormalize flag: this engine keeps working on the linear
//     irradiance after halation;
//   * the highlight-boost ops are dropped: apply_highlight_boost runs on the
//     CPU before this pass, exactly as model/diffusion.cpp orders it.
// Numerics: f32 throughout (owner decision on #205). Output is tolerance-bounded
// Fast GPU output, never Strict Exact CPU identity evidence.

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
const uint kThreadsPerGroup = 256u;

// Per-pixel ops (2D dispatch), per-column ops (1D dispatch) and the tiled
// transpose (2D dispatch over 32x32 tiles).
const uint kOpClear = 0u;
const uint kOpScatterResolve = 4u;
const uint kOpBounceResolveRaw = 10u;
// IIR-class channels (sigma >= 3), one thread per column. In place: both
// sweeps over buf1 (the transposed X pass). Accumulate: buf1 += weight *
// blur(in0), with buf3 as the forward-sweep scratch (the Y pass).
const uint kOpLineInPlace = 12u;
const uint kOpLineYAccumulate = 13u;
// FIR-class channels (sigma < 3): one thread per pixel, coalesced.
const uint kOpFirX = 14u;
const uint kOpFirYAccumulate = 16u;
// Tiled transpose in0 (w x h) -> buf1 (h x w); params.component is a
// channel mask (bit c writes channel c; 0 writes all three).
const uint kOpTranspose = 17u;

const uint kSigmaScatterCore = 0u;
const uint kSigmaScatterTail = 1u;
const uint kSigmaBounce = 2u;

// FrameFloats indices. 29..39 keep upstream's numbering; 80.. are Android additions.
const uint kFrameFilmPixelSizeUm = 29u;
const uint kFrameScatterAmount = 30u;
const uint kFrameScatterScale = 31u;
const uint kFrameHalationAmount = 32u;
const uint kFrameHalationScale = 33u;
const uint kFrameHalationStrengthR = 34u;
const uint kFrameHalationStrengthG = 35u;
const uint kFrameHalationStrengthB = 36u;
const uint kFrameHalationFirstSigmaR = 37u;
const uint kFrameHalationFirstSigmaG = 38u;
const uint kFrameHalationFirstSigmaB = 39u;
const uint kFrameScatterCoreUmR = 80u;
const uint kFrameScatterCoreUmG = 81u;
const uint kFrameScatterCoreUmB = 82u;
const uint kFrameScatterTailUmR = 83u;
const uint kFrameScatterTailUmG = 84u;
const uint kFrameScatterTailUmB = 85u;
const uint kFrameScatterTailWeightR = 86u;
const uint kFrameScatterTailWeightG = 87u;
const uint kFrameScatterTailWeightB = 88u;
const uint kFrameHalationRenormalize = 91u;
// BlurTable: base + (slot * 3 + channel) * kBlurStride + field. Slot 0 is the
// scatter core, 1..3 the exponential-tail surrogates, 4.. the bounces. The
// coefficient fields are double-float pairs (hi at the index, lo after it).
const uint kFrameBlurBase = 96u;
const uint kBlurStride = 12u;
const uint kBlurSlotCore = 0u;
const uint kBlurSlotTail = 1u;
const uint kBlurSlotBounce = 4u;
const uint kBlurFieldB = 3u;
const uint kBlurFieldP1 = 5u;
const uint kBlurFieldP2 = 7u;
const uint kBlurFieldP3 = 9u;
const uint kBlurFieldFirRadius = 11u;

// The sigma >= 3 FIR/IIR split and the FIR tap radius are the host's
// decisions and arrive in the blur table; this bound only keeps the tap loop
// finite if the table is ever wrong.
const int kMaxFirRadius = 256;

// Packed float triples: element (pixel, channel) is at pixel * 3 + channel.
layout(std430, binding = 0) readonly buffer Input0 {
  float in0[];
};

layout(std430, binding = 1) buffer Buffer1 {
  float buf1[];
};

layout(std430, binding = 2) readonly buffer Input2 {
  float in2[];
};

layout(std430, binding = 3) buffer Buffer3 {
  float buf3[];
};

layout(std430, binding = 27) readonly buffer FrameFloats {
  float frameFloats[];
};

// Same 104-byte block as upstream so the host-side push layout is shared with
// the other adapted passes; only width/height/operation/sigmaMode/component are
// consumed here.
layout(push_constant) uniform CoreParams {
  uint width;
  uint height;
  float filmExposureEv;
  float filmGamma;
  uint exposureCount;
  int inputColorSpace;
  int rgbToRawMethod;
  uint colorSpaceCount;
  uint transferLutSize;
  float colorDecodeMin;
  float colorDecodeMax;
  uint hanatosWidth;
  uint hanatosHeight;
  uint operation;
  uint sigmaMode;
  uint component;
  int filmPushPullMode;
  float filmPushPullStops;
  uint fullWidth;
  uint fullHeight;
  uint tileOriginX;
  uint tileOriginY;
  uint activeOriginX;
  uint activeOriginY;
  uint activeWidth;
  uint activeHeight;
} params;

float f(uint index) {
  return frameFloats[index];
}

// scipy.ndimage mode='reflect' (d c b a | a b c d | d c b a), repeated for
// radii wider than the axis, matching kernels/gaussian.cpp::reflect.
int reflectIndex(int i, int n) {
  if (n <= 1) {
    return 0;
  }
  const int period = 2 * n;
  i = i % period;
  if (i < 0) {
    i += period;
  }
  return i < n ? i : period - 1 - i;
}

// Per (blur slot, channel) table, computed by the host in f64 and read here
// verbatim: this shader derives no blur parameter of its own. Deriving them in
// f32 was wrong twice over. The Young-van Vliet poles sit ~1/q from the unit
// circle, so rounding the coefficients moves the poles by ~q^3 in relative
// terms (0.20 of a unit step at sigma 256 px, 2.5e-3 at 63 px, measured
// against the f64 CPU filter), which is why B and the three poles arrive as
// double-float (hi + lo) values rather than f32; and an f32 sigma computed
// here could land on the other side of the sigma = 3 FIR/IIR boundary from
// the host's f64 one, which decides which dispatches run, so a disagreeing
// channel would be left unwritten.
float blurSigma(uint slot, uint c) { return f(kFrameBlurBase + (slot * 3u + c) * kBlurStride + 0u); }
bool blurIsIir(uint slot, uint c) { return f(kFrameBlurBase + (slot * 3u + c) * kBlurStride + 1u) != 0.0; }
float blurWeight(uint slot, uint c) { return f(kFrameBlurBase + (slot * 3u + c) * kBlurStride + 2u); }
// int(3 * sigma + 0.5), computed by the host from the f64 sigma. Deriving it
// here from the f32 sigma would take one extra tap pair whenever rounding
// sigma up crosses an integer of 3 * sigma + 0.5, which reachable slider
// values do produce (measured 6.6e-2 on log10(raw), 660x the band).
int blurFirRadius(uint slot, uint c) {
  return min(int(f(kFrameBlurBase + (slot * 3u + c) * kBlurStride + kBlurFieldFirRadius)), kMaxFirRadius);
}

// The blur slot this dispatch is filtering: the scatter core, one of the three
// exponential-tail surrogates, or one bounce.
uint blurSlot() {
  if (params.sigmaMode == kSigmaScatterCore) {
    return kBlurSlotCore;
  }
  return (params.sigmaMode == kSigmaScatterTail ? kBlurSlotTail : kBlurSlotBounce) + params.component;
}

// Double-float (hi + lo) arithmetic for the recursion state and coefficients.
// Rounding injected at the output node is amplified by ~1/B (6e4 at sigma
// 63 px, 6e6 at 256 px): a plain f32 recursion drifts by 1e-2 there (measured
// on a flat field), where the CPU carries this state in f64. Dekker/Veltkamp
// split products and error-free sums, no FMA assumed (Vulkan does not promise
// fma() is fused); `precise` keeps the error terms from being contracted or
// reassociated away.
struct DF {
  float hi;
  float lo;
};

DF twoSum(float a, float b) {
  precise float s = a + b;
  precise float bb = s - a;
  precise float e = (a - (s - bb)) + (b - bb);
  return DF(s, e);
}

DF fastTwoSum(float a, float b) {  // |a| >= |b|, or a == 0
  precise float s = a + b;
  precise float e = b - (s - a);
  return DF(s, e);
}

// One coefficient as a double-float (hi + lo, the host's f64 value rounded
// twice) plus the 12-bit Veltkamp split of hi, computed once per column.
struct Coeff {
  float hi;
  float lo;
  float hh;
  float hl;
};

Coeff loadCoeff(uint slot, uint c, uint field) {
  const uint base = kFrameBlurBase + (slot * 3u + c) * kBlurStride + field;
  precise float hi = f(base);
  precise float lo = f(base + 1u);
  precise float t = 4097.0 * hi;
  precise float hh = t - (t - hi);
  return Coeff(hi, lo, hh, hi - hh);
}

// (k.hi + k.lo) * b, b exact: the Dekker product of k.hi and b, with k.lo * b
// folded into the error term.
DF prod(Coeff k, float b) {
  precise float t = 4097.0 * b;
  precise float bh = t - (t - b);
  precise float bl = b - bh;
  precise float p = k.hi * b;
  precise float e = ((k.hh * bh - p) + k.hh * bl + k.hl * bh) + k.hl * bl;
  precise float e2 = e + k.lo * b;
  return fastTwoSum(p, e2);
}

// coefficient * double-float state. prod() already covers (k.hi + k.lo) * w.hi,
// so only k * w.lo is left; adding k.lo * w.hi here as well would count the
// coefficient's low word twice and put the whole product back at f32 accuracy
// (measured: 1.5e-8 on one product, and the flat field then reads 5.7e-5 at
// sigma 12 px, exactly as if the coefficients were plain f32).
DF mulState(Coeff k, DF w) {
  DF p = prod(k, w.hi);
  precise float e = p.lo + k.hi * w.lo;
  return fastTwoSum(p.hi, e);
}

DF addDF(DF x, DF y) {
  DF s = twoSum(x.hi, y.hi);
  precise float e = s.lo + (x.lo + y.lo);
  return fastTwoSum(s.hi, e);
}

// One recursion step: B * x + p1 * w1 + p2 * w2 + p3 * w3.
DF iirStep(Coeff B, Coeff p1, Coeff p2, Coeff p3, float x, DF w1, DF w2, DF w3) {
  DF t = prod(B, x);
  t = addDF(t, mulState(p1, w1));
  t = addDF(t, mulState(p2, w2));
  return addDF(t, mulState(p3, w3));
}

// Element (j, channel c) of column `line` in a packed buffer.
uint columnElement(uint line, uint j, uint c) {
  return (j * params.width + line) * 3u + c;
}

// Young-van Vliet IIR of one channel down one column, in place on buf1. The
// CPU's edge initialisation: the forward state starts from the first sample,
// the backward state from the last forward-filtered sample
// (kernels/exponential_filter.cpp::iir_vertical). Storage is f32 between the
// sweeps and at the output, the state is double-float.
void iirColumnInPlace(uint line, uint n, uint slot, uint c) {
  const Coeff B = loadCoeff(slot, c, kBlurFieldB), p1 = loadCoeff(slot, c, kBlurFieldP1),
              p2 = loadCoeff(slot, c, kBlurFieldP2), p3 = loadCoeff(slot, c, kBlurFieldP3);
  DF w1 = DF(buf1[columnElement(line, 0u, c)], 0.0);
  DF w2 = w1;
  DF w3 = w1;
  for (uint j = 0u; j < n; ++j) {
    const uint idx = columnElement(line, j, c);
    const DF v = iirStep(B, p1, p2, p3, buf1[idx], w1, w2, w3);
    buf1[idx] = v.hi;
    w3 = w2;
    w2 = w1;
    w1 = v;
  }
  DF y1 = DF(buf1[columnElement(line, n - 1u, c)], 0.0);
  DF y2 = y1;
  DF y3 = y1;
  for (int jj = int(n) - 1; jj >= 0; --jj) {
    const uint idx = columnElement(line, uint(jj), c);
    const DF y = iirStep(B, p1, p2, p3, buf1[idx], y1, y2, y3);
    buf1[idx] = y.hi;
    y3 = y2;
    y2 = y1;
    y1 = y;
  }
}

// Same recursion from in0, accumulated into buf1 with `weight`; buf3 holds
// the forward sweep.
void iirColumnAccumulate(uint line, uint n, uint slot, uint c, float weight) {
  const Coeff B = loadCoeff(slot, c, kBlurFieldB), p1 = loadCoeff(slot, c, kBlurFieldP1),
              p2 = loadCoeff(slot, c, kBlurFieldP2), p3 = loadCoeff(slot, c, kBlurFieldP3);
  DF w1 = DF(in0[columnElement(line, 0u, c)], 0.0);
  DF w2 = w1;
  DF w3 = w1;
  for (uint j = 0u; j < n; ++j) {
    const uint idx = columnElement(line, j, c);
    const DF v = iirStep(B, p1, p2, p3, in0[idx], w1, w2, w3);
    buf3[idx] = v.hi;
    w3 = w2;
    w2 = w1;
    w1 = v;
  }
  DF y1 = DF(buf3[columnElement(line, n - 1u, c)], 0.0);
  DF y2 = y1;
  DF y3 = y1;
  for (int jj = int(n) - 1; jj >= 0; --jj) {
    const uint idx = columnElement(line, uint(jj), c);
    const DF y = iirStep(B, p1, p2, p3, buf3[idx], y1, y2, y3);
    buf1[idx] = buf1[idx] + weight * y.hi;
    y3 = y2;
    y2 = y1;
    y1 = y;
  }
}

// Truncated FIR Gaussian of one channel at one pixel along one axis, reflect
// boundaries, radius int(3 * sigma + 0.5); radius 0 is the identity. Weights
// via the incremental exp recurrence (upstream's form), normalised over the
// 2r + 1 taps exactly like the CPU kernel.
float firPixel(uvec2 gid, uint c, float sigma, int radius, bool alongX) {
  const int x = int(gid.x);
  const int y = int(gid.y);
  const float centre = in0[(gid.y * params.width + gid.x) * 3u + c];
  if (radius <= 0) {
    return centre;
  }
  const float invSigma2 = 1.0 / (sigma * sigma);
  float g = exp(-0.5 * invSigma2);
  float ratio = exp(-1.5 * invSigma2);
  const float ratioStep = exp(-invSigma2);
  float acc = centre;
  float weightSum = 1.0;
  const int n = alongX ? int(params.width) : int(params.height);
  const int p = alongX ? x : y;
  for (int k = 1; k <= radius; ++k) {
    const int lo = reflectIndex(p - k, n);
    const int hi = reflectIndex(p + k, n);
    const uint loIdx = alongX ? uint(y) * params.width + uint(lo) : uint(lo) * params.width + uint(x);
    const uint hiIdx = alongX ? uint(y) * params.width + uint(hi) : uint(hi) * params.width + uint(x);
    acc += (in0[loIdx * 3u + c] + in0[hiIdx * 3u + c]) * g;
    weightSum += 2.0 * g;
    g *= ratio;
    ratio *= ratioStep;
  }
  return acc / weightSum;
}

// Tiled transpose, in0 (width x height) -> buf1 (height x width), for the
// channels selected by the mask in params.component (0 = all): the IIR walks
// columns only, so an X pass transposes, filters in place, and transposes back.
shared float tile[3][32][32];

void transposeTile() {
  const uint mask = params.component == 0u ? 7u : params.component;
  const uvec2 local = gl_LocalInvocationID.xy;   // 32 x 8
  const uvec2 group = gl_WorkGroupID.xy;
  const uint x = group.x * 32u + local.x;
  for (uint k = 0u; k < 4u; ++k) {
    const uint y = group.y * 32u + local.y + k * 8u;
    if (x < params.width && y < params.height) {
      const uint idx = (y * params.width + x) * 3u;
      tile[0][local.y + k * 8u][local.x] = in0[idx];
      tile[1][local.y + k * 8u][local.x] = in0[idx + 1u];
      tile[2][local.y + k * 8u][local.x] = in0[idx + 2u];
    }
  }
  barrier();
  const uint tx = group.y * 32u + local.x;         // transposed x = original y
  for (uint k = 0u; k < 4u; ++k) {
    const uint ty = group.x * 32u + local.y + k * 8u;  // transposed y = original x
    if (tx < params.height && ty < params.width) {
      const uint idx = (ty * params.height + tx) * 3u;
      if ((mask & 1u) != 0u) buf1[idx] = tile[0][local.x][local.y + k * 8u];
      if ((mask & 2u) != 0u) buf1[idx + 1u] = tile[1][local.x][local.y + k * 8u];
      if ((mask & 4u) != 0u) buf1[idx + 2u] = tile[2][local.x][local.y + k * 8u];
    }
  }
}

void main() {
  if (params.operation == kOpTranspose) {
    transposeTile();
    return;
  }
  if (params.operation == kOpLineInPlace || params.operation == kOpLineYAccumulate) {
    const uint line = gl_WorkGroupID.x * kThreadsPerGroup + gl_LocalInvocationIndex;
    if (line >= params.width || params.height == 0u) {
      return;
    }
    const uint slot = blurSlot();
    if (params.operation == kOpLineInPlace) {
      for (uint c = 0u; c < 3u; ++c) {
        if (blurIsIir(slot, c)) {
          iirColumnInPlace(line, params.height, slot, c);
        }
      }
      return;
    }
    for (uint c = 0u; c < 3u; ++c) {
      if (blurIsIir(slot, c)) {
        iirColumnAccumulate(line, params.height, slot, c, blurWeight(slot, c));
      }
    }
    return;
  }

  const uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  const uint index = (gid.y * params.width + gid.x) * 3u;
  if (params.operation == kOpFirX || params.operation == kOpFirYAccumulate) {
    const bool alongX = params.operation == kOpFirX;
    const uint slot = blurSlot();
    for (uint c = 0u; c < 3u; ++c) {
      if (!blurIsIir(slot, c)) {
        const float v = firPixel(gid, c, blurSigma(slot, c), blurFirRadius(slot, c), alongX);
        buf1[index + c] = alongX ? v : buf1[index + c] + blurWeight(slot, c) * v;
      }
    }
    return;
  }
  if (params.operation == kOpClear) {
    buf1[index] = 0.0;
    buf1[index + 1u] = 0.0;
    buf1[index + 2u] = 0.0;
    return;
  }
  if (params.operation == kOpScatterResolve) {
    // raw = (1 - s) * raw + s * scattered, scattered already folded in buf1
    const vec3 raw = vec3(in0[index], in0[index + 1u], in0[index + 2u]);
    const vec3 scattered = vec3(buf1[index], buf1[index + 1u], buf1[index + 2u]);
    const float amount = f(kFrameScatterAmount);
    const vec3 resolved = (1.0 - amount) * raw + amount * scattered;
    buf3[index] = resolved.r;
    buf3[index + 1u] = resolved.g;
    buf3[index + 2u] = resolved.b;
    return;
  }
  if (params.operation == kOpBounceResolveRaw) {
    // raw = raw + a_tot * halation_blur ; if renormalize: raw /= (1 + a_tot)
    const vec3 raw = vec3(in0[index], in0[index + 1u], in0[index + 2u]);
    const vec3 blur = vec3(buf1[index], buf1[index + 1u], buf1[index + 2u]);
    // a_tot = halation_strength * halation_amount, exactly as
    // model/diffusion.cpp forms it: no clamp, because the CPU pass this must
    // stay within tolerance of does not clamp either.
    const vec3 amount = vec3(
      f(kFrameHalationStrengthR),
      f(kFrameHalationStrengthG),
      f(kFrameHalationStrengthB)
    ) * f(kFrameHalationAmount);
    vec3 resolved = raw + amount * blur;
    if (f(kFrameHalationRenormalize) > 0.5) {
      resolved /= (vec3(1.0) + amount);
    }
    buf3[index] = resolved.r;
    buf3[index + 1u] = resolved.g;
    buf3[index + 2u] = resolved.b;
  }
}
